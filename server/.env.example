PORT="5000"
NODE_ENV="development"
ORIGIN="http://localhost:3000"

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sift_flow"
REDIS_URL="redis://localhost:6379"

# Min 32 chars. Generate with: openssl rand -hex 32
SESSION_SECRET="change-me-to-at-least-32-random-characters"
SESSION_NAME="sift.sid"
SESSION_MAX_AGE_MS="86400000"
SESSION_ABSOLUTE_MAX_AGE_MS="604800000"

# Optional locally: without a key the invitation job fails with a clear log. Required in production.
RESEND_API_KEY=""
# The sender must sit on a domain verified in Resend; onboarding@resend.dev only delivers to the account owner.
RESEND_FROM_EMAIL="SiftFlow <onboarding@resend.dev>"
