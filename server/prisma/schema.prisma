generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(ulid())
  email     String   @unique
  fullName  String
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships        WorkspaceMember[] @relation("WorkspaceMemberUser")
  removedMemberships WorkspaceMember[] @relation("WorkspaceMemberRemovedBy")
  sentInvitations    Invitation[]      @relation("InvitationInvitedBy")

  @@map("users")
}

model Workspace {
  id        String   @id @default(ulid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     WorkspaceMember[]
  invitations Invitation[]

  @@map("workspaces")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum WorkspaceMemberStatus {
  ACTIVE
  REMOVED
}

model WorkspaceMember {
  id          String                @id @default(ulid())
  workspaceId String
  userId      String
  role        WorkspaceRole         @default(MEMBER)
  status      WorkspaceMemberStatus @default(ACTIVE)
  removedAt   DateTime?
  removedById String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("WorkspaceMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  removedBy User?     @relation("WorkspaceMemberRemovedBy", fields: [removedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELED
}

enum InvitationKind {
  EMAIL
  LINK
}

model Invitation {
  id          String           @id @default(ulid())
  workspaceId String
  kind        InvitationKind   @default(EMAIL)
  email       String?
  role        WorkspaceRole    @default(MEMBER)
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  invitedById String
  expiresAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([email])
  @@map("invitations")
}
